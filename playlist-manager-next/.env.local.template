# Auth0 Configuration
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_SECRET=long-random-secret-value
AUTH0_SCOPE=openid profile email
AUTH0_AUDIENCE=your-api-audience

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Spotify Configuration
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_ENDPOINT=/api/spotify/accept-user-token

# Database (if using Prisma)
DATABASE_URL=your-database-connection-string

# Last.fm album enrichment (listener/playcount stats, bio fallback). Free key from
# last.fm/api/account/create. Optional — enrichment degrades silently without it.
LASTFM_API_KEY=your-lastfm-api-key

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# Auth token for uploading source maps at build time. Read automatically by
# withSentryConfig() — no code references it directly. Never commit the real value.
SENTRY_AUTH_TOKEN=your-sentry-auth-token